<!-- Model Viewer Configuration -->
<script>
    // Configuración de model-viewer con imágenes de preview
    function configureModelViewer() {
        const modelConfigs = [
            { id: 'edf-model', previewId: 'edfs-preview' },
            { id: 'edf-model-mobile', previewId: 'edfs-preview-mobile' },
            { id: 'heart-model', previewId: 'heart-preview' },
            { id: 'pras-model', previewId: 'pras-preview' },
            { id: 'armor-model', previewId: 'armor-preview' },
            { id: 'heart-model-mobile', previewId: 'heart-preview-mobile' },
            { id: 'pras-model-mobile', previewId: 'pras-preview-mobile' },
            { id: 'armor-model-mobile', previewId: 'armor-preview-mobile' }
        ];
        
        modelConfigs.forEach(config => {
            const modelViewer = document.getElementById(config.id);
            const previewImg = config.previewId ? document.getElementById(config.previewId) : null;
            
            if (modelViewer) {
                // Configurar model-viewer
                modelViewer.setAttribute('interaction-prompt', 'none');
                
                // Solo manejar preview si existe
                if (previewImg) {
                    // Event listener para cuando el modelo se carga
                    modelViewer.addEventListener('load', () => {
                        // Ocultar la imagen de preview
                        previewImg.style.display = 'none';
                    });
                    
                    // Event listener para errores
                    modelViewer.addEventListener('error', (event:any) => {
                        console.error(`Error cargando modelo ${config.id}:`, event.detail);
                        // Mantener la imagen de preview visible si hay error
                    });
                    
                    // Event listener para cuando el modelo se está cargando
                    modelViewer.addEventListener('progress', (event:any) => {
                        const progress = event.detail.totalProgress;
                        if (progress === 1) {
                            // Modelo completamente cargado
                            previewImg.style.display = 'none';
                        }
                    });
                }
            }
        });
    }

    // Inicializar cuando el DOM esté listo
    document.addEventListener('DOMContentLoaded', configureModelViewer);
    
    // También inicializar si ya está cargado
    if (document.readyState !== 'loading') {
        configureModelViewer();
    }
</script>





